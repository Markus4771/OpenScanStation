[Unit]
Description=OpenScanStation Geräteeinstellungen
After=network.target openscanstation.service
Wants=openscanstation.service

[Service]
Type=simple
User=openscanstation
Group=openscanstation
WorkingDirectory=/opt/openscanstation
ExecStart=/usr/bin/openscanstation-device-settings --host 127.0.0.1 --port 8102
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openscanstation

[Install]
WantedBy=multi-user.target
