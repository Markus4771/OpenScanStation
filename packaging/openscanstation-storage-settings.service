[Unit]
Description=OpenScanStation Speicherziel-Verwaltung
After=network-online.target openscanstation.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/openscanstation
User=root
Group=root
ExecStart=/usr/bin/openscanstation-storage-settings --host 127.0.0.1 --port 8103
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openscanstation /var/lib/samba /etc/samba
ReadWritePaths=-/run/samba
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
