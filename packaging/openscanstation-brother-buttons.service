[Unit]
Description=OpenScanStation Brother Button Listener
After=network-online.target openscanstation.service
Wants=network-online.target
ConditionPathExists=/var/lib/openscanstation/brother_buttons.json

[Service]
Type=simple
WorkingDirectory=/opt/openscanstation
ExecStart=/usr/bin/openscanstation-brother-buttons run
Restart=on-failure
RestartSec=5
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openscanstation

[Install]
WantedBy=multi-user.target
