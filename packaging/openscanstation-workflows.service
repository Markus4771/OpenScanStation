[Unit]
Description=OpenScanStation Workflow Web Service
After=network-online.target openscanstation.service
Wants=network-online.target

[Service]
Type=simple
User=openscanstation
Group=openscanstation
ExecStart=/usr/bin/openscanstation-workflows --host 0.0.0.0 --port 8104
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openscanstation

[Install]
WantedBy=multi-user.target
